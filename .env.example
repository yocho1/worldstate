# ---------------------------------------------------------------------------
# worldstate — copy to `.env` and adjust values for your machine.
# `docker compose up` reads this file for variable interpolation and runtime
# environment. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# ---- FastAPI service ----
API_PORT=8000
LOG_LEVEL=INFO

# ---- Postgres (task-state store + episodic log, Sprints 2-3) ----
POSTGRES_USER=worldstate
POSTGRES_PASSWORD=worldstate
POSTGRES_DB=worldstate
POSTGRES_PORT=5432

# ---- Neo4j (entity/relationship graph, Sprints 4-5) ----
NEO4J_PASSWORD=worldstate-dev

# ---- Redis (broker for the consolidation worker, Sprint 7) ----
REDIS_PORT=6379

# ---- Anthropic (Sprint 1+: agent reasoning + structured extraction) ----
ANTHROPIC_API_KEY=sk-ant-replace-me
